// Atenea shell: flat robust layout, explicit light palette.
// Row0: menu bar (custom buttons, always visible).
// Row1: toolbar with real ISIS icons.
// Row2: left object panel (fixed 200px) + center tabs.
// Row3: status bar.
import { HorizontalBox, VerticalBox, TabWidget, ListView, LineEdit, Button } from "std-widgets.slint";

export struct PartRow {
    reference: string,
    kind: string,
    value: string,
}

export struct NetRow {
    id: string,
    pins: string,
}

export component Atenea inherits Window {
    title: "UNTITLED - Atenea (clon nativo interoperable)";
    min-width: 1100px;
    min-height: 700px;
    background: #eef2f6;

    in-out property <string> status: "listo";
    in-out property <string> coords: "+0.0 -0.0 th";
    in-out property <string> drc: "No ERC errors";
    in-out property <string> layer: "Top Copper";
    in-out property <string> filter: "";
    in-out property <[PartRow]> parts;
    in-out property <[NetRow]> nets;
    in-out property <string> erc_text: "";
    in-out property <string> sim_text: "";
    in-out property <[PartRow]> lib_parts;
    in-out property <string> lib_query: "";
    in-out property <image> sheet;
    in-out property <image> plot;

    callback open-file(string);
    callback open-lib();
    callback filter-lib(string);
    callback run-sim();
    callback run-erc();
    callback pick-device();
    callback tool-selected(string);

    VerticalBox {
        padding: 0;
        spacing: 0;
        // Row 0: single unified toolbar (native buttons, natural sizing).
        Rectangle {
            background: #1c2733;
            height: 34px;
            HorizontalBox {
                padding: 3px;
                spacing: 3px;
                Button { text: "File"; clicked => { root.open-file(""); } }
                Button { text: "View"; clicked => { root.tool-selected("view-tables"); } }
                Button { text: "Edit"; clicked => { root.tool-selected("edit"); } }
                Button { text: "Design"; clicked => { root.tool-selected("sheet-props"); } }
                Button { text: "Graph"; clicked => { root.tool-selected("view-sim"); } }
                Button { text: "Debug"; clicked => { root.tool-selected("debug"); } }
                Button { text: "Library"; clicked => { root.pick-device(); } }
                Button { text: "Template"; clicked => { root.tool-selected("template"); } }
                Button { text: "System"; clicked => { root.tool-selected("system"); } }
                Button { text: "Help"; clicked => { root.tool-selected("about"); } }
                Text { text: " | "; color: #8fa3bf; vertical-alignment: center; }
                Button { text: "Open"; icon: @image-url("../assets/folder.png"); clicked => { root.open-file(""); } }
                Button { text: "Pick"; icon: @image-url("../assets/chip.png"); clicked => { root.pick-device(); } }
                Button { text: "ERC"; icon: @image-url("../assets/bug.png"); clicked => { root.run-erc(); } }
                Button { text: "Sim"; icon: @image-url("../assets/sim_play.png"); clicked => { root.run-sim(); } }
                Text { text: "  Layer:"; color: #c8d3e0; vertical-alignment: center; }
                Button { text: root.layer; }
            }
        }
        // Row 2: icon rail + left panel + center.
        HorizontalBox {
            padding: 0;
            spacing: 0;
            Rectangle {
                background: #d7e0ec;
                width: 36px;
                VerticalBox {
                    padding: 2px;
                    spacing: 1px;
                    Button { icon: @image-url("../assets/tool_select.png"); clicked => { root.tool-selected("select"); } }
                    Button { icon: @image-url("../assets/chip.png"); clicked => { root.pick-device(); } }
                    Button { icon: @image-url("../assets/terminal.png"); clicked => { root.tool-selected("terminal"); } }
                    Button { icon: @image-url("../assets/wire.png"); clicked => { root.tool-selected("wire"); } }
                    Button { icon: @image-url("../assets/text.png"); clicked => { root.tool-selected("text"); } }
                    Button { icon: @image-url("../assets/box2d.png"); clicked => { root.tool-selected("box"); } }
                    Button { icon: @image-url("../assets/circle2d.png"); clicked => { root.tool-selected("circle"); } }
                    Button { icon: @image-url("../assets/sim_graph.png"); clicked => { root.tool-selected("view-sim"); } }
                    Button { icon: @image-url("../assets/sim_play.png"); clicked => { root.run-sim(); } }
                }
            }
            Rectangle {
                background: #e8edf3;
                width: 200px;
                VerticalBox {
                    padding: 3px;
                    spacing: 2px;
                    Text { text: "OVERVIEW"; color: #1c2733; font-size: 10px; font-weight: 700; horizontal-alignment: center; }
                    Rectangle {
                        background: #000000;
                        height: 130px;
                        Image { source: root.sheet; }
                    }
                    Text { text: "P  L  DEVICES"; color: #1c2733; font-size: 10px; font-weight: 700; horizontal-alignment: center; }
                    LineEdit { placeholder-text: "buscar…"; text <=> root.lib_query; edited(q) => { root.filter-lib(q); } }
                    ListView {
                        for p in root.lib_parts: HorizontalBox {
                            Text { text: p.reference; color: #1c2733; font-size: 11px; }
                        }
                    }
                    Button { text: "Open IDX…"; clicked => { root.open-lib(); } }
                }
            }
            VerticalBox {
                padding: 0;
                TabWidget {
                    Tab {
                        title: "Schematic Capture";
                        Rectangle {
                            background: #000000;
                            Image { source: root.sheet; }
                        }
                    }
                    Tab {
                        title: "Tables";
                        HorizontalBox {
                            VerticalBox {
                                Text { text: "Parts"; color: #1c2733; font-weight: 700; }
                                ListView {
                                    for p in root.parts: HorizontalBox {
                                        Text { text: p.reference; color: #1c2733; width: 90px; }
                                        Text { text: p.kind; color: #1c2733; width: 90px; }
                                        Text { text: p.value; color: #1c2733; }
                                    }
                                }
                            }
                            VerticalBox {
                                Text { text: "Nets"; color: #1c2733; font-weight: 700; }
                                ListView {
                                    for n in root.nets: HorizontalBox {
                                        Text { text: n.id; color: #1c2733; width: 110px; }
                                        Text { text: n.pins; color: #1c2733; }
                                    }
                                }
                            }
                        }
                    }
                    Tab {
                        title: "Simulate";
                        VerticalBox {
                            HorizontalBox {
                                Button { text: "Transient"; clicked => { root.tool-selected("graph-transient"); } }
                                Button { text: "Frequency"; clicked => { root.tool-selected("graph-frequency"); } }
                                Button { text: "DC Sweep"; clicked => { root.tool-selected("graph-dc"); } }
                                Button { text: "AC Sweep"; clicked => { root.tool-selected("graph-ac"); } }
                                Button { text: "Noise"; clicked => { root.tool-selected("graph-noise"); } }
                                Button { text: "Fourier"; clicked => { root.tool-selected("graph-fourier"); } }
                            }
                            Image { source: root.plot; }
                            Text { text: root.sim_text; color: #1c2733; }
                        }
                    }
                    Tab {
                        title: "ERC";
                        VerticalBox {
                            Text { text: root.erc_text; color: #1c2733; }
                        }
                    }
                }
            }
        }
        // Row 3: status bar.
        Rectangle {
            background: #dfe6f2;
            height: 24px;
            HorizontalBox {
                alignment: start;
                padding: 3px;
                spacing: 12px;
                Text { text: root.status; color: #1c2733; font-size: 11px; }
                Text { text: "✓ " + root.drc; color: #1c2733; font-size: 11px; }
                Text { text: root.coords; color: #1c2733; font-size: 11px; }
            }
        }
    }
}
