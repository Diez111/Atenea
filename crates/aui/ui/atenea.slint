// Atenea shell, Proteus 8 look: explicit LIGHT palette (COSMIC dark
// must not bleed in), compact toolbars, left preview/object-selector,
// tabs + editing window + status bar. Data from aengine only.
import { HorizontalBox, VerticalBox, TabWidget, ListView, LineEdit, Button } from "std-widgets.slint";

export struct PartRow {
    reference: string,
    kind: string,
    value: string,
}

export struct NetRow {
    id: string,
    pins: string,
}

export component Atenea inherits Window {
    title: "UNTITLED - Atenea (clon nativo interoperable)";
    min-width: 1100px;
    min-height: 700px;
    background: #eef2f6;

    in-out property <string> status: "listo";
    in-out property <string> coords: "+0.0 -0.0 th";
    in-out property <string> drc: "No ERC errors";
    in-out property <string> layer: "Top Copper";
    in-out property <string> filter: "";
    in-out property <[PartRow]> parts;
    in-out property <[NetRow]> nets;
    in-out property <string> erc_text: "";
    in-out property <string> sim_text: "";
    in-out property <[PartRow]> lib_parts;
    in-out property <string> lib_query: "";
    in-out property <image> sheet;
    in-out property <image> plot;

    callback open-file(string);
    callback open-lib();
    callback filter-lib(string);
    callback run-sim();
    callback run-erc();
    callback pick-device();
    callback tool-selected(string);

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "Open…"; activated => { root.open-file(""); } }
        }
        Menu { title: "Output"; }
        Menu {
            title: "View";
            MenuItem { title: "Tables"; }
            MenuItem { title: "Graph"; }
            MenuItem { title: "Esquema"; }
            MenuItem { title: "Simulate"; }
        }
        Menu { title: "Edit"; }
        Menu {
            title: "Library";
            MenuItem { title: "Pick Device…"; activated => { root.pick-device(); } }
        }
        Menu { title: "Tools"; }
        Menu { title: "Technology"; }
        Menu { title: "System"; }
        Menu {
            title: "Graph";
            MenuItem { title: "Add Transient Graph"; activated => { root.tool-selected("graph-transient"); } }
            MenuItem { title: "Add Frequency Graph"; activated => { root.tool-selected("graph-frequency"); } }
            MenuItem { title: "Add DC Sweep Graph"; activated => { root.tool-selected("graph-dc"); } }
            MenuItem { title: "Add AC Sweep Graph"; activated => { root.tool-selected("graph-ac"); } }
            MenuItem { title: "Run ERC"; activated => { root.run-erc(); } }
        }
        Menu {
            title: "Help";
            MenuItem { title: "About Atenea"; }
        }
    }
    VerticalBox {
        padding: 0;
        spacing: 0;
        // Toolbar row: compact, light band.
        Rectangle {
            background: #dfe6f2;
            height: 34px;
            HorizontalBox {
                padding: 2px;
                spacing: 2px;
                Button { text: "Open"; icon: @image-url("../assets/i1_16x16.png"); clicked => { root.open-file(""); } }
                Button { text: "Pick"; icon: @image-url("../assets/i11_16x16.png"); clicked => { root.pick-device(); } }
                Button { text: "ERC"; icon: @image-url("../assets/i13_16x16.png"); clicked => { root.run-erc(); } }
                Button { text: "Sim"; icon: @image-url("../assets/i15_16x16.png"); clicked => { root.run-sim(); } }
                Text { text: "  Layer:"; color: #1c2733; font-size: 11px; vertical-alignment: center; }
                Button { text: root.layer; }
            }
        }
        HorizontalBox {
            padding: 0;
            spacing: 0;
            // Left rail: mode tools, compact square buttons.
            Rectangle {
                background: #dfe6f2;
                width: 40px;
                VerticalBox {
                    padding: 2px;
                    spacing: 2px;
                    Button { text: "➤"; height: 30px; clicked => { root.tool-selected("select"); } }
                    Button { text: "↖"; height: 30px; clicked => { root.tool-selected("move"); } }
                    Button { text: "✎"; height: 30px; clicked => { root.tool-selected("wire"); } }
                    Button { text: "▦"; height: 30px; clicked => { root.tool-selected("bus"); } }
                    Button { text: "T"; height: 30px; clicked => { root.tool-selected("label"); } }
                    Button { text: "●"; height: 30px; clicked => { root.tool-selected("probe"); } }
                }
            }
            // Object selector: preview + components list.
            Rectangle {
                background: #e8edf3;
                width: 190px;
                VerticalBox {
                    padding: 3px;
                    spacing: 2px;
                    Text { text: "PREVIEW"; color: #1c2733; font-size: 10px; font-weight: 700; horizontal-alignment: center; }
                    Rectangle {
                        background: #000000;
                        height: 130px;
                        Image { source: root.sheet; }
                    }
                    Text { text: "COMPONENTS"; color: #1c2733; font-size: 10px; font-weight: 700; horizontal-alignment: center; }
                    LineEdit { placeholder-text: "buscar…"; text <=> root.lib_query; edited(q) => { root.filter-lib(q); } }
                    ListView {
                        for p in root.lib_parts: HorizontalBox {
                            Text { text: p.reference; color: #1c2733; font-size: 11px; }
                        }
                    }
                    Button { text: "Open IDX…"; clicked => { root.open-lib(); } }
                }
            }
            // Center: tabs + editing window.
            VerticalBox {
                padding: 0;
                TabWidget {
                    Tab {
                        title: "Schematic Capture";
                        Rectangle {
                            background: #000000;
                            Image { source: root.sheet; }
                        }
                    }
                    Tab {
                        title: "Tables";
                        HorizontalBox {
                            VerticalBox {
                                Text { text: "Parts"; color: #1c2733; font-weight: 700; }
                                ListView {
                                    for p in root.parts: HorizontalBox {
                                        Text { text: p.reference; color: #1c2733; width: 90px; }
                                        Text { text: p.kind; color: #1c2733; width: 90px; }
                                        Text { text: p.value; color: #1c2733; }
                                    }
                                }
                            }
                            VerticalBox {
                                Text { text: "Nets"; color: #1c2733; font-weight: 700; }
                                ListView {
                                    for n in root.nets: HorizontalBox {
                                        Text { text: n.id; color: #1c2733; width: 110px; }
                                        Text { text: n.pins; color: #1c2733; }
                                    }
                                }
                            }
                        }
                    }
                    Tab {
                        title: "Simulate";
                        VerticalBox {
                            Image { source: root.plot; }
                            Text { text: root.sim_text; color: #1c2733; }
                        }
                    }
                    Tab {
                        title: "ERC";
                        VerticalBox {
                            Text { text: root.erc_text; color: #1c2733; }
                        }
                    }
                }
            }
        }
        // Status bar: light band, dark text.
        Rectangle {
            background: #dfe6f2;
            height: 24px;
            HorizontalBox {
                padding: 3px;
                spacing: 12px;
                Text { text: root.status; color: #1c2733; font-size: 11px; }
                Text { text: "✓ " + root.drc; color: #1c2733; font-size: 11px; }
                Text { text: root.coords; color: #1c2733; font-size: 11px; }
            }
        }
    }
}
